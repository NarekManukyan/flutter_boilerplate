#!/bin/sh
# Git pre-commit hook: fix, format and analyze the staged Dart files.
#
# Install once per clone: melos run hooks:install
#                         (runs git config core.hooksPath tool/git-hooks)
# Skip it for one commit: git commit --no-verify
#
# - Touches only staged, hand-written .dart files. Generated code (*.g.dart,
#   *.freezed.dart, *.gr.dart, *.config.dart, *.gen.dart, *.tailor.dart and
#   anything under lib/gen/) is skipped.
# - Re-stages exactly the files it fixed and formatted, nothing else.
# - Aborts, before changing anything, when a staged file also has unstaged
#   edits: re-staging that file would sneak those edits into the commit.
# - Fails the commit when `dart analyze --fatal-warnings` reports a problem in
#   those files.
#
# POSIX sh: no bash-only syntax.

set -u

if [ -t 1 ] && [ -t 2 ]; then
  RED=$(printf '\033[0;31m')
  GREEN=$(printf '\033[0;32m')
  YELLOW=$(printf '\033[1;33m')
  RESET=$(printf '\033[0m')
else
  RED='' GREEN='' YELLOW='' RESET=''
fi

say() { printf '%s%s%s\n' "$YELLOW" "$*" "$RESET"; }
ok() { printf '%s%s%s\n' "$GREEN" "$*" "$RESET"; }
die() {
  printf '%spre-commit: %s%s\n' "$RED" "$*" "$RESET" >&2
  exit 1
}

ROOT=$(git rev-parse --show-toplevel) || die "not inside a git work tree."
cd "$ROOT" || die "cannot cd to $ROOT."

# Git GUI clients often run hooks with a minimal PATH, so look beyond it.
find_dart() {
  if command -v dart >/dev/null 2>&1; then
    command -v dart
    return 0
  fi
  if command -v flutter >/dev/null 2>&1; then
    candidate="$(dirname "$(command -v flutter)")/dart"
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  for candidate in \
    "${FLUTTER_ROOT:+$FLUTTER_ROOT/bin/dart}" \
    "$ROOT/.fvm/flutter_sdk/bin/dart" \
    "$HOME/fvm/default/bin/dart" \
    "$HOME/flutter/bin/dart" \
    "$HOME/development/flutter/bin/dart" \
    /opt/homebrew/bin/dart \
    /usr/local/bin/dart; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

STAGED=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- '*.dart' |
  grep -vE '\.(g|freezed|gr|config|gen|tailor)\.dart$' |
  grep -vE '(^|/)lib/gen/' ||
  true)

if [ -z "$STAGED" ]; then
  ok "pre-commit: no staged hand-written Dart files, nothing to check."
  exit 0
fi

DART=$(find_dart) || die "dart not found. Put the Flutter or Dart SDK on PATH (or set FLUTTER_ROOT), or skip the hook with git commit --no-verify."

# One file per positional parameter. Newline is the only separator, so paths
# with spaces survive.
old_ifs=$IFS
IFS='
'
set -f
# shellcheck disable=SC2086 # word splitting on newlines is intended
set -- $STAGED
set +f
IFS=$old_ifs

PARTIAL=$(git -c core.quotePath=false --literal-pathspecs diff --name-only -- "$@")
if [ -n "$PARTIAL" ]; then
  {
    printf '%spre-commit: these staged Dart files also have unstaged changes:%s\n' "$RED" "$RESET"
    printf '%s\n' "$PARTIAL" | sed 's/^/  /'
    echo "The hook fixes, formats and re-stages whole files, which would commit those unstaged changes too."
    echo "Stage them (git add <file>) or stash them (git stash push --keep-index), then commit again."
    echo "To commit without the hook: git commit --no-verify"
  } >&2
  exit 1
fi

say "pre-commit: dart fix --apply on $# staged Dart file(s)..."
for f in "$@"; do
  # dart fix takes one file or directory per run. A failure is only a
  # warning: whatever it could not fix, analyze reports below.
  if ! out=$("$DART" fix --apply "$f" 2>&1); then
    printf '%s\n' "$out" >&2
    say "pre-commit: dart fix failed on $f, continuing (analyze runs next)."
  else
    case "$out" in
      *"Nothing to fix"*) ;;
      *) printf '%s\n' "$out" ;;
    esac
  fi
done

say "pre-commit: dart format..."
"$DART" format "$@" || die "dart format failed (syntax error?). Fix the file(s) above and commit again."

# Safe: none of these files had unstaged changes, so this stages only what fix
# and format just changed. Other modified files in the work tree stay unstaged.
git --literal-pathspecs add -- "$@" || die "git add failed while re-staging the fixed files."

say "pre-commit: dart analyze --fatal-warnings..."
if ! "$DART" analyze --fatal-warnings "$@"; then
  die "dart analyze found problems in the staged files. Fix them and commit again. If they are about missing generated files, run melos run build first. Fix and format changes are already staged."
fi

ok "pre-commit: all checks passed."
exit 0

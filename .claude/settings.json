{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(flutter --version)",
      "Bash(dart --version)",
      "Bash(melos --version)",
      "Bash(melos list:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart fix:*)",
      "Bash(dart run build_runner:*)",
      "Bash(flutter pub get)",
      "Bash(melos bootstrap)",
      "Bash(melos run analyze)",
      "Bash(melos run test)",
      "Bash(melos run test:coverage)",
      "Bash(melos run format)",
      "Bash(melos run format:check)",
      "Bash(melos run lint)",
      "Bash(melos run verify)",
      "Bash(melos run verify:quick)",
      "Bash(melos run build)",
      "Bash(melos run build:api)",
      "Bash(melos run build:design_system)",
      "Bash(melos run build:app)",
      "Bash(melos run translations)",
      "Bash(melos run sync-agents)",
      "Bash(./tool/sync_agents.sh:*)",
      "Bash(./tool/run_maestro.sh:*)",
      "Bash(melos run maestro)",
      "Bash(melos run maestro:happy)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:docs.maestro.dev)",
      "WebFetch(domain:mobx.netlify.app)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/track_change.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/post_turn.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
